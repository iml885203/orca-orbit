{
  "manifestVersion": 2,
  "id": "orbit-status",
  "name": "Orbit",
  "version": "0.1.1",
  "description": "Read-only Orbit status: running instances, each instance's containers and services, SQL project sync, and logs in a terminal tab.",
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.247"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "orbit",
        "title": "Orbit",
        "icon": "rocket",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "workspace:read"
    }
  ]
}
